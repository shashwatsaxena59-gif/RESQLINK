# ==============================================================================
# RESQLINK ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env for local development. NEVER commit real secrets to git.
# ==============================================================================

# --- Application Server Configuration ---
PORT=3001
NODE_ENV=development

# --- Cryptographic Secret for Token Signing ---
# Replace with a high-entropy 256-bit secret in production
AUTH_SECRET=resqlink_demo_insecure_secret_replace_in_production_32bytes_min

# --- AI Assist (Google Gemini API) ---
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Remote Supabase Configuration (Optional - for cloud deployment) ---
# Leave empty to run with local Express backend and IndexedDB outbox
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-client-key-here
SUPABASE_SERVICE_ROLE_KEY=your-privileged-service-role-key-server-only
