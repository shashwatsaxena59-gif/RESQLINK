# ==============================================================================
# RESQLINK SERVER ENVIRONMENT CONFIGURATION
# Copy to server/.env. NEVER commit real secrets to version control.
# ==============================================================================

PORT=3001
NODE_ENV=development

# High-entropy secret for signing authentication tokens
AUTH_SECRET=resqlink_server_secret_change_in_production_min_32_characters

# AI Assistance Engine (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Service Role Key (Server-Only, never expose to frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
